{
  "manifest_version": 3,
  "name": "YT Filter",
  "version": "0.2.0",
  "description": "A calmer YouTube: hides Shorts, members-only and old videos, skips repeats in autoplay, and sets player defaults.",
  "browser_specific_settings": {
    "gecko": {
      "id": "yt-filter@loftspace",
      "strict_min_version": "142.0",
      "data_collection_permissions": { "required": ["none"] }
    }
  },
  "icons": { "48": "icons/icon.svg", "96": "icons/icon.svg" },
  "permissions": ["storage"],
  "host_permissions": ["*://www.youtube.com/*"],
  "content_scripts": [
    {
      "matches": ["*://www.youtube.com/*"],
      "js": ["src/parse.js", "src/content.js"],
      "css": ["src/content.css"],
      "run_at": "document_idle"
    },
    {
      "matches": ["*://www.youtube.com/*"],
      "js": ["src/parse.js", "src/main.js"],
      "world": "MAIN",
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "YT Filter",
    "default_popup": "popup/popup.html",
    "default_icon": "icons/icon.svg"
  }
}
